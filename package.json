{
  "name": "web-channel",
  "version": "0.1.1",
  "description": "OpenClaw Web Channel Plugin - ChatGPT-style Web UI",
  "type": "module",
  "main": "dist/index.js",
  "keywords": ["openclaw", "web", "channel", "plugin", "chat", "sse"],
  "author": "chouzz",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "web",
    "openclaw.plugin.json",
    "README.md",
    "PROPOSAL.md"
  ],
  "openclaw": {
    "extensions": ["./dist/index.js"]
  },
  "scripts": {
    "build": "pnpm build:web && pnpm build:plugin",
    "build:web": "cd web && pnpm run build",
    "build:plugin": "tsc",
    "dev": "pnpm dev:web",
    "dev:web": "cd web && pnpm dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && cd web && tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.10.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.8.0"
  }
}
